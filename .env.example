# ──────────────────────────────────────────────────────────────────────────────
#  deadline_bot — environment variables
#  Copy this file to .env and fill in the values. Never commit .env to Git.
# ──────────────────────────────────────────────────────────────────────────────

# Telegram Bot token obtained from @BotFather
TELEGRAM_BOT_TOKEN=123456789:AABBCCDDaabbccdd_example_token

# Public HTTPS URL forwarded by your reverse proxy to this service.
# Keep the path private and forward it unchanged.
WEBHOOK_URL=https://bot.example.com/telegram/webhook/replace-with-random-path
WEBHOOK_SECRET_TOKEN=replace_with_a_random_secret_token
WEBHOOK_LISTEN_ADDR=:8080
WEBHOOK_PORT=8080

# Telegram user ID of the owner (use @userinfobot to find your ID)
OWNER_TELEGRAM_ID=123456789

# Absolute path to the SQLite database file
# When running in Docker this is set automatically to /data/bot.db
DATABASE_PATH=./data/bot.db

# Optional persistent Turso database (recommended on free Render)
# When set, Turso is used instead of the local DATABASE_PATH.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# IANA timezone used for deadline display and scheduled reminders
GROUP_TIMEZONE=Europe/Minsk

# How often the notification worker checks for due jobs (default: 1m)
NOTIFICATION_CHECK_INTERVAL=1m

# Log level: debug | info | warn | error  (default: info)
LOG_LEVEL=info
